<UserControl x:Class="ConstruSys.Desktop.Views.Estoque.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Estoque"
                               Style="{StaticResource PageTitle}"/>

                    <TextBlock Text="Controle de saldos e movimentações"
                               Style="{StaticResource PageSubtitle}"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Nova Movimentação"
                        Width="170"
                        Style="{StaticResource PrimaryButton}"
                        Click="NovaMovimentacao_Click"/>

            </Grid>

            <!-- CARDS -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource DefaultCard}">

                    <StackPanel>

                        <TextBlock Text="Produtos"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock x:Name="TxtTotalProdutos"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource DefaultCard}">

                    <StackPanel>

                        <TextBlock Text="Estoque Normal"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock x:Name="TxtEstoqueNormal"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource DefaultCard}">

                    <StackPanel>

                        <TextBlock Text="Estoque Baixo"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock x:Name="TxtEstoqueBaixo"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="6"
                        Style="{StaticResource DefaultCard}">

                    <StackPanel>

                        <TextBlock Text="Sem Estoque"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock x:Name="TxtSemEstoque"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- FILTROS -->

            <Border Grid.Row="4"
                    Style="{StaticResource DefaultCard}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="15"/>

                        <ColumnDefinition Width="190"/>

                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtPesquisa"
                             Style="{StaticResource DefaultTextBox}"
                             KeyUp="TxtPesquisa_KeyUp"/>

                    <ComboBox x:Name="CmbFiltro"
                              Grid.Column="2"
                              Style="{StaticResource DefaultComboBox}"
                              SelectionChanged="CmbFiltro_SelectionChanged">

                        <ComboBoxItem Content="Todos"
                                      IsSelected="True"/>

                        <ComboBoxItem Content="Normal"/>

                        <ComboBoxItem Content="Estoque baixo"/>

                        <ComboBoxItem Content="Sem estoque"/>

                    </ComboBox>

                </Grid>

            </Border>

            <!-- TABELA -->

            <Border Grid.Row="6"
                    Style="{StaticResource DefaultCard}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="15"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Posição de estoque"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock x:Name="TxtQuantidade"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                    </Grid>

                    <DataGrid x:Name="GridProdutos"
                              Grid.Row="2"
                              Style="{StaticResource DefaultDataGrid}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                        Binding="{Binding Codigo}"
                        Width="100"/>

                            <DataGridTextColumn Header="Produto"
                        Binding="{Binding Nome}"
                        Width="*"/>

                            <DataGridTextColumn Header="Un."
                        Binding="{Binding UnidadeMedida}"
                        Width="70"/>

                            <DataGridTextColumn Header="Atual"
                        Binding="{Binding EstoqueAtual, StringFormat={}{0:0.###}}"
                        Width="100"/>

                            <DataGridTextColumn Header="Mínimo"
                        Binding="{Binding EstoqueMinimo, StringFormat={}{0:0.###}}"
                        Width="100"/>

                            <DataGridTextColumn Header="Máximo"
                        Binding="{Binding EstoqueMaximo, StringFormat={}{0:0.###}}"
                        Width="100"/>

                            <DataGridTemplateColumn Header="Situação"
                            Width="135">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Border Padding="8,4"
                        CornerRadius="6"
                        HorizontalAlignment="Left">

                                            <Border.Style>
                                                <Style TargetType="Border">

                                                    <Setter Property="Background"
                                    Value="#DCFCE7"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding StatusEstoque}"
                                             Value="Estoque baixo">

                                                            <Setter Property="Background"
                                            Value="#FEF3C7"/>

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding StatusEstoque}"
                                             Value="Sem estoque">

                                                            <Setter Property="Background"
                                            Value="#FEE2E2"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding StatusEstoque}"
                               FontWeight="SemiBold"
                               FontSize="11">

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="Foreground"
                                        Value="#166534"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding StatusEstoque}"
                                                 Value="Estoque baixo">

                                                                <Setter Property="Foreground"
                                                Value="#92400E"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding StatusEstoque}"
                                                 Value="Sem estoque">

                                                                <Setter Property="Foreground"
                                                Value="#991B1B"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>
                                                </TextBlock.Style>

                                            </TextBlock>

                                        </Border>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Ação"
                            Width="145">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Button Content="Movimentar"
                        Width="105"
                        Height="32"
                        Padding="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}"
                        Tag="{Binding}"
                        Click="MovimentarProduto_Click"/>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>