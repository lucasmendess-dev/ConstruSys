<Window x:Class="ConstruSys.Desktop.Views.Estoque.JanelaMovimentacaoEstoque"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimentação de Estoque"
        Width="580"
        Height="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="22"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="22"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <StackPanel>

            <TextBlock x:Name="TxtTitulo"
                       Text="Nova movimentação"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock Text="Registre entradas, saídas ou ajustes no estoque"
                       Style="{StaticResource PageSubtitle}"/>

        </StackPanel>

        <!-- FORMULÁRIO -->

        <Border Grid.Row="2"
                Style="{StaticResource DefaultCard}">

            <StackPanel>

                <TextBlock Text="Produto"
                           Style="{StaticResource FieldLabel}"/>

                <ComboBox x:Name="CmbProduto"
                          Style="{StaticResource DefaultComboBox}"
                          DisplayMemberPath="Nome"
                          SelectionChanged="CmbProduto_SelectionChanged"/>

                <Grid Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="20"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Tipo de movimentação"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox x:Name="CmbTipo"
                                  Style="{StaticResource DefaultComboBox}"
                                  SelectionChanged="CmbTipo_SelectionChanged">

                            <ComboBoxItem Content="Entrada"
                                          IsSelected="True"/>

                            <ComboBoxItem Content="Saída"/>

                            <ComboBoxItem Content="Ajuste"/>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock x:Name="TxtLabelQuantidade"
                                   Text="Quantidade"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="TxtQuantidade"
                                 Style="{StaticResource DefaultTextBox}"/>

                    </StackPanel>

                </Grid>

                <Border Margin="0,18,0,0"
                        Padding="14"
                        CornerRadius="7"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Estoque atual"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock x:Name="TxtEstoqueAtual"
                                   Grid.Column="1"
                                   Text="0,000"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                    </Grid>

                </Border>

                <TextBlock Text="Observação"
                           Margin="0,18,0,0"
                           Style="{StaticResource FieldLabel}"/>

                <TextBox x:Name="TxtObservacao"
                         Height="80"
                         Padding="10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"/>

            </StackPanel>

        </Border>

        <!-- BOTÕES -->

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="15"/>

                <ColumnDefinition Width="140"/>

            </Grid.ColumnDefinitions>

            <Button Content="Cancelar"
                    Style="{StaticResource SecondaryButton}"
                    Click="Cancelar_Click"/>

            <Button Grid.Column="2"
                    Content="Registrar"
                    Style="{StaticResource PrimaryButton}"
                    Click="Registrar_Click"/>

        </Grid>

    </Grid>

</Window>