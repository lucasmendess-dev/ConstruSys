<Window x:Class="ConstruSys.Desktop.Views.Estoque.JanelaMovimentacaoEstoque"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimentação de Estoque"
        Width="600"
        Height="650"
        MinWidth="600"
        MinHeight="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="74"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- CABEÇALHO -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundBrush}"
                Padding="30,26,30,18">

            <StackPanel>

                <TextBlock x:Name="TxtTitulo"
                           Text="Nova movimentação"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="Registre entradas, saídas ou ajustes no estoque"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

            </StackPanel>

        </Border>

        <!-- ===================================================== -->
        <!-- CONTEÚDO -->
        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Margin="30,0,30,24"
                    Padding="20"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">

                <StackPanel>

                    <!-- PRODUTO -->

                    <TextBlock Text="Produto"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox x:Name="CmbProduto"
                              Height="40"
                              Style="{StaticResource DefaultComboBox}"
                              DisplayMemberPath="Nome"
                              SelectionChanged="CmbProduto_SelectionChanged"/>

                    <!-- TIPO / QUANTIDADE -->

                    <Grid Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TIPO -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Tipo de movimentação"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="CmbTipo"
                                      Height="40"
                                      Style="{StaticResource DefaultComboBox}"
                                      SelectionChanged="CmbTipo_SelectionChanged">

                                <ComboBoxItem Content="Entrada"/>

                                <ComboBoxItem Content="Saída"/>

                                <ComboBoxItem Content="Ajuste"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- QUANTIDADE -->

                        <StackPanel Grid.Column="2">

                            <TextBlock x:Name="TxtLabelQuantidade"
                                       Text="Quantidade"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="TxtQuantidade"
                                     Height="40"
                                     Style="{StaticResource DefaultTextBox}"/>

                        </StackPanel>

                    </Grid>

                    <!-- ESTOQUE ATUAL -->

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="7"
                            Background="#F8FAFC"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Estoque atual"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock x:Name="TxtEstoqueAtual"
                                       Grid.Column="1"
                                       Text="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                        </Grid>

                    </Border>

                    <!-- OBSERVAÇÃO -->

                    <TextBlock Text="Observação"
                               Margin="0,18,0,0"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtObservacao"
                             Height="110"
                             MinHeight="110"
                             Padding="10"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1"
                             Background="White"
                             Foreground="#111827"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- ===================================================== -->
        <!-- RODAPÉ FIXO -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="30,16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Height="40"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancelar_Click"/>

                <Button Grid.Column="2"
                        Content="Registrar"
                        Height="40"
                        Style="{StaticResource PrimaryButton}"
                        Click="Registrar_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>