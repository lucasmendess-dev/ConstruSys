<UserControl x:Class="ConstruSys.Desktop.Views.Clientes.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Clientes"
                               Style="{StaticResource PageTitle}"/>

                    <TextBlock Text="Cadastro e gerenciamento de clientes"
                               Style="{StaticResource PageSubtitle}"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Novo Cliente"
                        Width="150"
                        Style="{StaticResource PrimaryButton}"
                        Click="NovoCliente_Click"/>

            </Grid>

            <!-- CARDS -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource DefaultCard}">

                    <StackPanel>

                        <TextBlock Text="Total de Clientes"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtTotalCard"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource DefaultCard}">

                    <StackPanel>

                        <TextBlock Text="Clientes Ativos"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtAtivosCard"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource DefaultCard}">

                    <StackPanel>

                        <TextBlock Text="Clientes Inativos"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtInativosCard"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- FILTROS -->

            <Border Grid.Row="4"
                    Style="{StaticResource DefaultCard}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtPesquisa"
                             Style="{StaticResource DefaultTextBox}"
                             KeyUp="TxtPesquisa_KeyUp"/>

                    <ComboBox x:Name="CmbFiltroStatus"
                              Grid.Column="2"
                              Style="{StaticResource DefaultComboBox}"
                              SelectionChanged="CmbFiltroStatus_SelectionChanged">

                        <ComboBoxItem Content="Todos"
                                      IsSelected="True"/>

                        <ComboBoxItem Content="Ativos"/>

                        <ComboBoxItem Content="Inativos"/>

                    </ComboBox>

                    <Button Grid.Column="4"
                            Content="Pesquisar"
                            Style="{StaticResource SecondaryButton}"
                            Click="Pesquisar_Click"/>

                </Grid>

            </Border>

            <!-- LISTAGEM -->

            <Border Grid.Row="6"
                    Style="{StaticResource DefaultCard}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Clientes cadastrados"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock x:Name="TxtQuantidade"
                                   Grid.Column="1"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <DataGrid x:Name="GridClientes"
                              Grid.Row="2"
                              Style="{StaticResource DefaultDataGrid}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nome"
                                                Binding="{Binding NomeRazaoSocial}"
                                                Width="*"/>

                            <DataGridTextColumn Header="CPF/CNPJ"
                                                Binding="{Binding CpfCnpj}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Telefone"
                                                Binding="{Binding Telefone}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Cidade"
                                                Binding="{Binding Cidade}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Limite"
                                                Binding="{Binding LimiteCredito, StringFormat=C2}"
                                                Width="110"/>

                            <DataGridTemplateColumn Header="Status"
                                                    Width="90">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock FontWeight="SemiBold">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Text"
                                                            Value="Ativo"/>

                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource SuccessBrush}"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Ativo}"
                                                                     Value="False">

                                                            <Setter Property="Text"
                                                                    Value="Inativo"/>

                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource DangerBrush}"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Ações"
                                                    Width="155">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <Button Width="82"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding}"
                                                    Click="AlterarStatusCliente_Click">

                                                <Button.Style>

                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource StatusButton}">

                                                        <Setter Property="Content"
                                                                Value="Inativar"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Ativo}"
                                                                         Value="False">

                                                                <Setter Property="Content"
                                                                        Value="Ativar"/>

                                                                <Setter Property="Background"
                                                                        Value="#ECFDF5"/>

                                                                <Setter Property="Foreground"
                                                                        Value="#047857"/>

                                                                <Setter Property="BorderBrush"
                                                                        Value="#A7F3D0"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Button.Style>

                                            </Button>

                                            <Grid>

                                                <ToggleButton x:Name="BtnMenu"
                                                              Content="⋮"
                                                              Style="{StaticResource MenuDotsButton}"/>

                                                <Popup IsOpen="{Binding IsChecked, ElementName=BtnMenu}"
                                                       PlacementTarget="{Binding ElementName=BtnMenu}"
                                                       Placement="Bottom"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True">

                                                    <Border Background="White"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="4"
                                                            Width="135">

                                                        <StackPanel>

                                                            <Button Content="Visualizar"
                                                                    Style="{StaticResource MenuItemButton}"
                                                                    Tag="{Binding}"
                                                                    Click="VisualizarCliente_Click"/>

                                                            <Button Content="Editar"
                                                                    Style="{StaticResource MenuItemButton}"
                                                                    Tag="{Binding}"
                                                                    Click="EditarCliente_Click"/>

                                                            <Separator Margin="4"/>

                                                            <Button Content="Excluir"
                                                                    Style="{StaticResource MenuItemButton}"
                                                                    Foreground="{StaticResource DangerBrush}"
                                                                    Tag="{Binding}"
                                                                    Click="ExcluirCliente_Click"/>

                                                        </StackPanel>

                                                    </Border>

                                                </Popup>

                                            </Grid>

                                        </StackPanel>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>