<Window x:Class="ConstruSys.Desktop.Views.Clientes.JanelaCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente"
        Width="800"
        Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>

                <TextBlock x:Name="TxtTitulo"
                           Text="Novo Cliente"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                <TextBlock Text="Preencha os dados do cliente"
                           Margin="0,5,0,0"
                           Foreground="#6B7280"/>

            </StackPanel>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TIPO -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="0">

                        <TextBlock Text="Tipo de Pessoa *"/>

                        <ComboBox x:Name="CmbTipoPessoa"
                                  Height="36"
                                  Margin="0,6,0,0">

                            <ComboBoxItem Content="Física"
                                          IsSelected="True"/>

                            <ComboBoxItem Content="Jurídica"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- CPF/CNPJ -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="2">

                        <TextBlock Text="CPF / CNPJ"/>

                        <TextBox x:Name="TxtCpfCnpj"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- NOME -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">

                        <TextBlock Text="Nome / Razão Social *"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="TxtNome"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- FANTASIA -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="0">

                        <TextBlock Text="Nome Fantasia"/>

                        <TextBox x:Name="TxtNomeFantasia"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- RG/IE -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="2">

                        <TextBlock Text="RG / Inscrição Estadual"/>

                        <TextBox x:Name="TxtRgIe"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- TELEFONE -->

                    <StackPanel Grid.Row="6"
                                Grid.Column="0">

                        <TextBlock Text="Telefone"/>

                        <TextBox x:Name="TxtTelefone"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- WHATSAPP -->

                    <StackPanel Grid.Row="6"
                                Grid.Column="2">

                        <TextBlock Text="WhatsApp"/>

                        <TextBox x:Name="TxtWhatsApp"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- EMAIL -->

                    <StackPanel Grid.Row="8"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">

                        <TextBlock Text="E-mail"/>

                        <TextBox x:Name="TxtEmail"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- CEP -->

                    <StackPanel Grid.Row="10"
                                Grid.Column="0">

                        <TextBlock Text="CEP"/>

                        <TextBox x:Name="TxtCep"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- ENDEREÇO -->

                    <StackPanel Grid.Row="10"
                                Grid.Column="2">

                        <TextBlock Text="Endereço"/>

                        <TextBox x:Name="TxtEndereco"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- NÚMERO -->

                    <StackPanel Grid.Row="12"
                                Grid.Column="0">

                        <TextBlock Text="Número"/>

                        <TextBox x:Name="TxtNumero"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- BAIRRO -->

                    <StackPanel Grid.Row="12"
                                Grid.Column="2">

                        <TextBlock Text="Bairro"/>

                        <TextBox x:Name="TxtBairro"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- CIDADE -->

                    <StackPanel Grid.Row="14"
                                Grid.Column="0">

                        <TextBlock Text="Cidade"/>

                        <TextBox x:Name="TxtCidade"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- ESTADO -->

                    <StackPanel Grid.Row="14"
                                Grid.Column="2">

                        <TextBlock Text="Estado"/>

                        <TextBox x:Name="TxtEstado"
                                 Height="36"
                                 MaxLength="2"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- LIMITE -->

                    <StackPanel Grid.Row="16"
                                Grid.Column="0">

                        <TextBlock Text="Limite de Crédito"/>

                        <TextBox x:Name="TxtLimiteCredito"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <CheckBox x:Name="ChkAtivo"
                              Grid.Row="16"
                              Grid.Column="2"
                              Content="Cliente ativo"
                              IsChecked="True"
                              VerticalAlignment="Center"/>

                </Grid>

            </Border>

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Height="42"
                        Background="#E5E7EB"
                        BorderThickness="0"
                        Click="Cancelar_Click"/>

                <Button Grid.Column="2"
                        Content="Salvar"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="Salvar_Click"/>

            </Grid>

        </Grid>

    </ScrollViewer>

</Window>