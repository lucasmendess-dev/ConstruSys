<Window x:Class="ConstruSys.Desktop.Views.Produtos.JanelaProduto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Produto"
        Width="940"
        Height="790"
        MinWidth="900"
        MinHeight="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="30,22">

            <StackPanel>

                <TextBlock x:Name="TxtTitulo"
                           Text="Novo Produto"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="Preencha as informações do produto"
                           Style="{StaticResource PageSubtitle}"/>

            </StackPanel>

        </Border>

        <!-- FORMULÁRIO -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid Margin="30,24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CÓDIGO -->

                <StackPanel Grid.Row="0"
                            Grid.Column="0">

                    <TextBlock Text="Código *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtCodigo"
                             Style="{StaticResource DefaultTextBox}"/>

                </StackPanel>

                <!-- CÓDIGO BARRAS -->

                <StackPanel Grid.Row="0"
                            Grid.Column="2">

                    <TextBlock Text="Código de Barras"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtCodigoBarras"
                             Style="{StaticResource DefaultTextBox}"/>

                </StackPanel>

                <!-- NOME -->

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">

                    <TextBlock Text="Nome do Produto *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtNome"
                             Style="{StaticResource DefaultTextBox}"/>

                </StackPanel>

                <!-- CATEGORIA -->

                <StackPanel Grid.Row="4"
                            Grid.Column="0">

                    <TextBlock Text="Categoria"
                               Style="{StaticResource FieldLabel}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CmbCategoria"
                                  Style="{StaticResource DefaultComboBox}"
                                  DisplayMemberPath="Nome"/>

                        <Button Grid.Column="2"
                                Content="+"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="18"
                                Padding="0"
                                Click="NovaCategoria_Click"/>

                    </Grid>

                </StackPanel>

                <!-- SUBCATEGORIA -->

                <StackPanel Grid.Row="4"
                            Grid.Column="2">

                    <TextBlock Text="Subcategoria"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtSubcategoria"
                             Style="{StaticResource DefaultTextBox}"/>

                </StackPanel>

                <!-- MARCA -->

                <StackPanel Grid.Row="6"
                            Grid.Column="0">

                    <TextBlock Text="Marca"
                               Style="{StaticResource FieldLabel}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CmbMarca"
                                  Style="{StaticResource DefaultComboBox}"
                                  DisplayMemberPath="Nome"/>

                        <Button Grid.Column="2"
                                Content="+"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="18"
                                Padding="0"
                                Click="NovaMarca_Click"/>

                    </Grid>

                </StackPanel>

                <!-- UNIDADE -->

                <StackPanel Grid.Row="6"
                            Grid.Column="2">

                    <TextBlock Text="Unidade de Medida *"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox x:Name="CmbUnidade"
                              Style="{StaticResource DefaultComboBox}">

                        <ComboBoxItem Content="UN"/>
                        <ComboBoxItem Content="CX"/>
                        <ComboBoxItem Content="PC"/>
                        <ComboBoxItem Content="KG"/>
                        <ComboBoxItem Content="G"/>
                        <ComboBoxItem Content="M"/>
                        <ComboBoxItem Content="M²"/>
                        <ComboBoxItem Content="M³"/>
                        <ComboBoxItem Content="L"/>
                        <ComboBoxItem Content="ML"/>
                        <ComboBoxItem Content="SC"/>
                        <ComboBoxItem Content="RL"/>

                    </ComboBox>

                </StackPanel>

                <!-- LOCALIZAÇÃO -->

                <StackPanel Grid.Row="8"
                            Grid.Column="0">

                    <TextBlock Text="Localização no Estoque"
                               Style="{StaticResource FieldLabel}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CmbLocalizacao"
                                  Style="{StaticResource DefaultComboBox}"
                                  DisplayMemberPath="Nome"/>

                        <Button Grid.Column="2"
                                Content="+"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="18"
                                Padding="0"
                                Click="NovaLocalizacao_Click"/>

                    </Grid>

                </StackPanel>

                <!-- PESO -->

                <StackPanel Grid.Row="8"
                            Grid.Column="2">

                    <TextBlock Text="Peso"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtPeso"
                             Style="{StaticResource DefaultTextBox}"/>

                </StackPanel>

                <!-- PREÇOS -->

                <StackPanel Grid.Row="10"
                            Grid.Column="0">

                    <TextBlock Text="Preço de Custo"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtPrecoCusto"
                             Style="{StaticResource DefaultTextBox}"/>

                </StackPanel>

                <StackPanel Grid.Row="10"
                            Grid.Column="2">

                    <TextBlock Text="Preço de Venda"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtPrecoVenda"
                             Style="{StaticResource DefaultTextBox}"/>

                </StackPanel>

                <!-- ESTOQUE -->

                <Grid Grid.Row="12"
                      Grid.Column="0"
                      Grid.ColumnSpan="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Estoque Atual"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="TxtEstoqueAtual"
                                 Style="{StaticResource DefaultTextBox}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Estoque Mínimo"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="TxtEstoqueMinimo"
                                 Style="{StaticResource DefaultTextBox}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="4">

                        <TextBlock Text="Estoque Máximo"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="TxtEstoqueMaximo"
                                 Style="{StaticResource DefaultTextBox}"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </ScrollViewer>

        <!-- RODAPÉ -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="30,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ChkAtivo"
                          Content="Produto ativo"
                          IsChecked="True"
                          VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancelar_Click"/>

                <Button Grid.Column="4"
                        Content="Salvar"
                        Style="{StaticResource PrimaryButton}"
                        Click="Salvar_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>