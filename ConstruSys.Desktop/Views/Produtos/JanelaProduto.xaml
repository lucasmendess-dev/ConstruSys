<Window x:Class="ConstruSys.Desktop.Views.Produtos.JanelaProduto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Produto"
        Width="720"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>

                <TextBlock x:Name="TxtTitulo"
                           Text="Novo Produto"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                <TextBlock Text="Preencha os dados do produto"
                           Margin="0,5,0,0"
                           Foreground="#6B7280"/>

            </StackPanel>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CÓDIGO -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="0">

                        <TextBlock Text="Código *"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="TxtCodigo"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- CÓDIGO DE BARRAS -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="2">

                        <TextBlock Text="Código de Barras"/>

                        <TextBox x:Name="TxtCodigoBarras"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- NOME -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">

                        <TextBlock Text="Nome *"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="TxtNome"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- CATEGORIA -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="0">

                        <TextBlock Text="Categoria"/>

                        <TextBox x:Name="TxtCategoria"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- MARCA -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="2">

                        <TextBlock Text="Marca"/>

                        <TextBox x:Name="TxtMarca"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- UNIDADE -->

                    <StackPanel Grid.Row="6"
                                Grid.Column="0">

                        <TextBlock Text="Unidade *"/>

                        <ComboBox x:Name="CmbUnidade"
                                  Height="36"
                                  Margin="0,6,0,0">

                            <ComboBoxItem Content="UN"/>
                            <ComboBoxItem Content="CX"/>
                            <ComboBoxItem Content="PC"/>
                            <ComboBoxItem Content="KG"/>
                            <ComboBoxItem Content="G"/>
                            <ComboBoxItem Content="M"/>
                            <ComboBoxItem Content="M²"/>
                            <ComboBoxItem Content="M³"/>
                            <ComboBoxItem Content="L"/>
                            <ComboBoxItem Content="ML"/>
                            <ComboBoxItem Content="SC"/>
                            <ComboBoxItem Content="RL"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- LOCALIZAÇÃO -->

                    <StackPanel Grid.Row="6"
                                Grid.Column="2">

                        <TextBlock Text="Localização no Estoque"/>

                        <TextBox x:Name="TxtLocalizacao"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- PREÇO CUSTO -->

                    <StackPanel Grid.Row="8"
                                Grid.Column="0">

                        <TextBlock Text="Preço de Custo"/>

                        <TextBox x:Name="TxtPrecoCusto"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- PREÇO VENDA -->

                    <StackPanel Grid.Row="8"
                                Grid.Column="2">

                        <TextBlock Text="Preço de Venda"/>

                        <TextBox x:Name="TxtPrecoVenda"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- ESTOQUE -->

                    <StackPanel Grid.Row="10"
                                Grid.Column="0">

                        <TextBlock Text="Estoque Atual"/>

                        <TextBox x:Name="TxtEstoqueAtual"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- ESTOQUE MÍNIMO -->

                    <StackPanel Grid.Row="10"
                                Grid.Column="2">

                        <TextBlock Text="Estoque Mínimo"/>

                        <TextBox x:Name="TxtEstoqueMinimo"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- ATIVO -->

                    <CheckBox x:Name="ChkAtivo"
                              Grid.Row="12"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Content="Produto ativo"
                              IsChecked="True"/>

                </Grid>

            </Border>

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Height="42"
                        Background="#E5E7EB"
                        BorderThickness="0"
                        Click="Cancelar_Click"/>

                <Button Grid.Column="2"
                        Content="Salvar"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="Salvar_Click"/>

            </Grid>

        </Grid>

    </ScrollViewer>

</Window>