<UserControl x:Class="ConstruSys.Desktop.Views.Produtos.ProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F3F4F6">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="PRODUTOS TESTE 123"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Cadastro e gerenciamento dos produtos da loja"
                               Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="#6B7280"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Novo Produto"
                        Width="150"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="NovoProduto_Click"/>

            </Grid>

            <!-- PESQUISA -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtPesquisa"
                             Grid.Column="0"
                             Height="38"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             KeyUp="TxtPesquisa_KeyUp"/>

                    <Button Grid.Column="2"
                            Content="Pesquisar"
                            Height="38"
                            Background="#111827"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Pesquisar_Click"/>

                </Grid>

            </Border>

            <!-- LISTAGEM -->
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Produtos cadastrados"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock x:Name="TxtTotalProdutos"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"/>

                    </Grid>

                    <DataGrid x:Name="GridProdutos"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F9FAFB"
                              RowHeight="42">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding Codigo}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Produto"
                                                Binding="{Binding Nome}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Categoria"
                                                Binding="{Binding Categoria}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Marca"
                                                Binding="{Binding Marca}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Un."
                                                Binding="{Binding UnidadeMedida}"
                                                Width="60"/>

                            <DataGridTextColumn Header="Estoque"
                                                Binding="{Binding EstoqueAtual, StringFormat=N3}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Custo"
                                                Binding="{Binding PrecoCusto, StringFormat=C2}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Venda"
                                                Binding="{Binding PrecoVenda, StringFormat=C2}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Margem"
                                                Binding="{Binding MargemLucro, StringFormat={}{0:N2}%}"
                                                Width="90"/>

                            <DataGridTemplateColumn Header="Ações"
                                                    Width="150">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                            <Button Content="Editar"
                                                    Width="60"
                                                    Height="28"
                                                    Margin="2"
                                                    Tag="{Binding}"
                                                    Click="EditarProduto_Click"/>

                                            <Button Content="Excluir"
                                                    Width="60"
                                                    Height="28"
                                                    Margin="2"
                                                    Tag="{Binding}"
                                                    Click="ExcluirProduto_Click"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>