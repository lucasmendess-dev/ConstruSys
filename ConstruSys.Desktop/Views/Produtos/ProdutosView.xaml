<UserControl x:Class="ConstruSys.Desktop.Views.Produtos.ProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="30">

                <!-- ===================================================== -->
                <!-- CABEÇALHO -->
                <!-- ===================================================== -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Produtos"
                                   Style="{StaticResource PageTitle}"/>

                        <TextBlock Text="Gerencie os produtos cadastrados no sistema"
                                   Style="{StaticResource PageSubtitle}"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="+ Novo Produto"
                            Width="150"
                            Height="40"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}"
                            Click="NovoProduto_Click"/>

                </Grid>

                <!-- ===================================================== -->
                <!-- INDICADORES -->
                <!-- ===================================================== -->

                <Grid Margin="0,25,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TOTAL -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DefaultCard}">

                        <StackPanel>

                            <TextBlock Text="Total de Produtos"
                                       Foreground="#64748B"
                                       FontSize="12"/>

                            <TextBlock x:Name="TxtTotalProdutos"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                        </StackPanel>

                    </Border>

                    <!-- ATIVOS -->

                    <Border Grid.Column="2"
                            Style="{StaticResource DefaultCard}">

                        <StackPanel>

                            <TextBlock Text="Produtos Ativos"
                                       Foreground="#64748B"
                                       FontSize="12"/>

                            <TextBlock x:Name="TxtProdutosAtivos"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#059669"/>

                        </StackPanel>

                    </Border>

                    <!-- ESTOQUE BAIXO -->

                    <Border Grid.Column="4"
                            Style="{StaticResource DefaultCard}">

                        <StackPanel>

                            <TextBlock Text="Estoque Baixo"
                                       Foreground="#64748B"
                                       FontSize="12"/>

                            <TextBlock x:Name="TxtEstoqueBaixo"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#D97706"/>

                        </StackPanel>

                    </Border>

                    <!-- SEM ESTOQUE -->

                    <Border Grid.Column="6"
                            Style="{StaticResource DefaultCard}">

                        <StackPanel>

                            <TextBlock Text="Sem Estoque"
                                       Foreground="#64748B"
                                       FontSize="12"/>

                            <TextBlock x:Name="TxtSemEstoque"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#DC2626"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ===================================================== -->
                <!-- FILTROS -->
                <!-- ===================================================== -->

                <Border Margin="0,20,0,0"
                        Style="{StaticResource DefaultCard}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <!-- PESQUISA -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Pesquisar"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="TxtPesquisa"
                                     Style="{StaticResource DefaultTextBox}"
                                     KeyUp="TxtPesquisa_KeyUp"/>

                        </StackPanel>

                        <!-- FILTRO -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Filtrar por"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="CmbFiltro"
                                      Style="{StaticResource DefaultComboBox}"
                                      SelectionChanged="CmbFiltro_SelectionChanged">

                                <ComboBoxItem Content="Todos"
                                              IsSelected="True"/>

                                <ComboBoxItem Content="Ativos"/>

                                <ComboBoxItem Content="Inativos"/>

                                <ComboBoxItem Content="Estoque baixo"/>

                                <ComboBoxItem Content="Sem estoque"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- BOTÃO -->

                        <Button Grid.Column="4"
                                Content="Pesquisar"
                                Margin="0,21,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="Pesquisar_Click"/>

                    </Grid>

                </Border>

                <!-- ===================================================== -->
                <!-- TABELA -->
                <!-- ===================================================== -->

                <Border Margin="0,20,0,30"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TÍTULO -->

                        <Grid Margin="20,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Lista de produtos"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                            <TextBlock Grid.Column="1"
                                   Foreground="#64748B"
                                   FontSize="12">

                            <Run Text="Total: "/>

                            <Run Text="{Binding ElementName=DgProdutos,
                                               Path=Items.Count,
                                               Mode=OneWay}"/>

                            </TextBlock>

                        </Grid>

                        <!-- DATAGRID -->

                        <DataGrid x:Name="DgProdutos"
                                  Grid.Row="1"
                                  Style="{StaticResource DefaultDataGrid}"
                                  MinHeight="280"
                                  MaxHeight="520">

                            <DataGrid.Columns>

                                <!-- CÓDIGO -->

                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding Codigo}"
                                                    Width="100"/>

                                <!-- PRODUTO -->

                                <DataGridTextColumn Header="Produto"
                                                    Binding="{Binding Nome}"
                                                    Width="*"/>

                                <!-- CATEGORIA -->

                                <DataGridTextColumn Header="Categoria"
                                                    Binding="{Binding Categoria}"
                                                    Width="150"/>

                                <!-- MARCA -->

                                <DataGridTextColumn Header="Marca"
                                                    Binding="{Binding Marca}"
                                                    Width="130"/>

                                <!-- ESTOQUE -->

                                <DataGridTextColumn Header="Estoque"
                                                    Binding="{Binding EstoqueAtual,
                                                                      StringFormat={}{0:0.###}}"
                                                    Width="85"/>

                                <!-- SITUAÇÃO ESTOQUE -->

                                <DataGridTemplateColumn Header="Situação"
                                                        Width="125">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Padding="8,4"
                                                    CornerRadius="6"
                                                    HorizontalAlignment="Left">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter Property="Background"
                                                                Value="#DCFCE7"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding StatusEstoque}"
                                                                         Value="Estoque baixo">

                                                                <Setter Property="Background"
                                                                        Value="#FEF3C7"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding StatusEstoque}"
                                                                         Value="Sem estoque">

                                                                <Setter Property="Background"
                                                                        Value="#FEE2E2"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <TextBlock Text="{Binding StatusEstoque}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">

                                                    <TextBlock.Style>

                                                        <Style TargetType="TextBlock">

                                                            <Setter Property="Foreground"
                                                                    Value="#166534"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding StatusEstoque}"
                                                                             Value="Estoque baixo">

                                                                    <Setter Property="Foreground"
                                                                            Value="#92400E"/>

                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding StatusEstoque}"
                                                                             Value="Sem estoque">

                                                                    <Setter Property="Foreground"
                                                                            Value="#991B1B"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- PREÇO -->

                                <DataGridTextColumn Header="Venda"
                                                    Binding="{Binding PrecoVenda,
                                                                      StringFormat={}{0:C2}}"
                                                    Width="100"/>

                                <!-- MARGEM -->

                                <DataGridTextColumn Header="Margem"
                                                    Binding="{Binding MargemLucro,
                                                                      StringFormat={}{0:0.##}%}"
                                                    Width="85"/>

                                <!-- STATUS -->

                                <DataGridTemplateColumn Header="Status"
                                                        Width="90">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="Text"
                                                                Value="ATIVO"/>

                                                        <Setter Property="Foreground"
                                                                Value="#059669"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Ativo}"
                                                                         Value="False">

                                                                <Setter Property="Text"
                                                                        Value="INATIVO"/>

                                                                <Setter Property="Foreground"
                                                                        Value="#DC2626"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- AÇÕES -->

                                <DataGridTemplateColumn Header="Ações"
                                                        Width="160">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <!-- ATIVAR / INATIVAR -->

                                                <Button Width="82"
                                                        Height="30"
                                                        Margin="0,0,6,0"
                                                        Tag="{Binding}"
                                                        Click="AlterarStatusProduto_Click">

                                                    <Button.Style>

                                                        <Style TargetType="Button"
                                                            BasedOn="{StaticResource StatusButton}">

                                                            <Setter Property="Content"
                                                                  Value="Inativar"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding Ativo}"
                                                                    Value="False">

                                                                    <Setter Property="Content"
                                                                         Value="Ativar"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </Button.Style>

                                                </Button>

                                                <!-- MENU -->

                                                <ToggleButton x:Name="BtnMenu"
                                                              Style="{StaticResource MenuDotsButton}"
                                                              Content="⋮"/>

                                                <Popup PlacementTarget="{Binding ElementName=BtnMenu}"
                                                       Placement="Bottom"
                                                       IsOpen="{Binding IsChecked,
                                                                        ElementName=BtnMenu}"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True">

                                                    <Border Width="150"
                                                            Padding="6"
                                                            Margin="0,5,0,0"
                                                            Background="White"
                                                            BorderBrush="#E5E7EB"
                                                            BorderThickness="1"
                                                            CornerRadius="7">

                                                        <StackPanel>

                                                            <Button Content="Visualizar"
                                                                    Style="{StaticResource MenuItemButton}"
                                                                    Tag="{Binding}"
                                                                    Click="VisualizarProduto_Click"/>

                                                            <Button Content="Editar"
                                                                    Style="{StaticResource MenuItemButton}"
                                                                    Tag="{Binding}"
                                                                    Click="EditarProduto_Click"/>

                                                            <Border Height="1"
                                                                    Background="#E5E7EB"
                                                                    Margin="5"/>

                                                            <Button Content="Excluir"
                                                                    Style="{StaticResource MenuItemButton}"
                                                                    Foreground="#DC2626"
                                                                    Tag="{Binding}"
                                                                    Click="ExcluirProduto_Click"/>

                                                        </StackPanel>

                                                    </Border>

                                                </Popup>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>