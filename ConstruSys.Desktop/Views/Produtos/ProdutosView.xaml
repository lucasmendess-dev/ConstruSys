<UserControl x:Class="ConstruSys.Desktop.Views.Produtos.ProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="18"/>

        </Style>

        <!-- BOTÃO BASE -->

        <Style x:Key="BotaoBase"
               TargetType="Button">

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- BOTÃO STATUS -->

        <Style x:Key="BotaoStatus"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="#FFFBEB"/>

            <Setter Property="Foreground"
                    Value="#B45309"/>

            <Setter Property="BorderBrush"
                    Value="#FDE68A"/>

        </Style>

        <!-- BOTÃO MENU -->

        <Style x:Key="BotaoMenu"
               TargetType="ToggleButton">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Background"
                    Value="#F9FAFB"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <!-- ITEM MENU -->

        <Style x:Key="BotaoMenuItem"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3F4F6"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Background="#F3F4F6">

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Produtos"
                           Style="{StaticResource PageTitle}"/>

                    <TextBlock Text="Gerencie produtos, preços e estoque"
                           Style="{StaticResource PageSubtitle}"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Novo Produto"
                        Width="155"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="NovoProduto_Click"/>

            </Grid>

            <!-- CARDS -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Total de Produtos"
                                   Foreground="#6B7280"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtCardTotal"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   Foreground="#111827"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Produtos Ativos"
                                   Foreground="#6B7280"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtCardAtivos"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   Foreground="#059669"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Estoque Baixo"
                                   Foreground="#6B7280"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtCardEstoqueBaixo"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   Foreground="#D97706"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="6"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Sem Estoque"
                                   Foreground="#6B7280"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtCardSemEstoque"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   Foreground="#DC2626"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- FILTROS -->

            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="10"
                    Padding="18">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="15"/>

                        <ColumnDefinition Width="190"/>

                        <ColumnDefinition Width="15"/>

                        <ColumnDefinition Width="110"/>

                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtPesquisa"
                             Grid.Column="0"
                             Height="38"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             KeyUp="TxtPesquisa_KeyUp"/>

                    <ComboBox x:Name="CmbFiltro"
                              Grid.Column="2"
                              Height="38"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbFiltro_SelectionChanged">

                        <ComboBoxItem Content="Todos"
                                      IsSelected="True"/>

                        <ComboBoxItem Content="Ativos"/>

                        <ComboBoxItem Content="Inativos"/>

                        <ComboBoxItem Content="Estoque baixo"/>

                        <ComboBoxItem Content="Sem estoque"/>

                    </ComboBox>

                    <Button Grid.Column="4"
                            Content="Pesquisar"
                            Height="38"
                            Background="#111827"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Pesquisar_Click"/>

                </Grid>

            </Border>

            <!-- TABELA -->

            <Border Grid.Row="6"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="15"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Produtos cadastrados"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock x:Name="TxtTotalProdutos"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"/>

                    </Grid>

                    <DataGrid x:Name="GridProdutos"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F9FAFB"
                              RowHeight="44">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding Codigo}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Produto"
                                                Binding="{Binding Nome}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Categoria"
                                                Binding="{Binding Categoria}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Estoque"
                                                Binding="{Binding EstoqueAtual, StringFormat={}{0:0.###}}"
                                                Width="85"/>

                            <!-- SITUAÇÃO ESTOQUE -->

                            <DataGridTemplateColumn Header="Situação"
                                                    Width="110">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Border Padding="8,4"
                                                CornerRadius="6"
                                                HorizontalAlignment="Left">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter Property="Background"
                                                            Value="#DCFCE7"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding StatusEstoque}"
                                                                     Value="Estoque baixo">

                                                            <Setter Property="Background"
                                                                    Value="#FEF3C7"/>

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding StatusEstoque}"
                                                                     Value="Sem estoque">

                                                            <Setter Property="Background"
                                                                    Value="#FEE2E2"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <TextBlock Text="{Binding StatusEstoque}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="Foreground"
                                                                Value="#166534"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding StatusEstoque}"
                                                                         Value="Estoque baixo">

                                                                <Setter Property="Foreground"
                                                                        Value="#92400E"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding StatusEstoque}"
                                                                         Value="Sem estoque">

                                                                <Setter Property="Foreground"
                                                                        Value="#991B1B"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </Border>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Venda"
                                                Binding="{Binding PrecoVenda, StringFormat=C2}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Margem"
                                                Binding="{Binding MargemLucro, StringFormat={}{0:N1}%}"
                                                Width="80"/>

                            <!-- STATUS -->

                            <DataGridTemplateColumn Header="Status"
                                                    Width="85">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding StatusCadastro}"
                                                   FontWeight="SemiBold">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Foreground"
                                                            Value="#059669"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Ativo}"
                                                                     Value="False">

                                                            <Setter Property="Foreground"
                                                                    Value="#DC2626"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- AÇÕES -->

                            <DataGridTemplateColumn Header="Ações"
                                                    Width="155">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <!-- ATIVAR / INATIVAR -->

                                            <Button Width="82"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding}"
                                                    Click="AlterarStatusProduto_Click">

                                                <Button.Style>

                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource BotaoStatus}">

                                                        <Setter Property="Content"
                                                                Value="Inativar"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Ativo}"
                                                                         Value="False">

                                                                <Setter Property="Content"
                                                                        Value="Ativar"/>

                                                                <Setter Property="Background"
                                                                        Value="#ECFDF5"/>

                                                                <Setter Property="Foreground"
                                                                        Value="#047857"/>

                                                                <Setter Property="BorderBrush"
                                                                        Value="#A7F3D0"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Button.Style>

                                            </Button>

                                            <!-- DROPDOWN -->

                                            <Grid>

                                                <ToggleButton x:Name="BtnMenu"
                                                              Content="⋮"
                                                              Style="{StaticResource BotaoMenu}"/>

                                                <Popup IsOpen="{Binding IsChecked, ElementName=BtnMenu}"
                                                       PlacementTarget="{Binding ElementName=BtnMenu}"
                                                       Placement="Bottom"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True">

                                                    <Border Background="White"
                                                            BorderBrush="#D1D5DB"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="4"
                                                            Width="130">

                                                        <StackPanel>

                                                            <Button Content="Visualizar"
                                                                    Style="{StaticResource BotaoMenuItem}"
                                                                    Tag="{Binding}"
                                                                    Click="VisualizarProduto_Click"/>

                                                            <Button Content="Editar"
                                                                    Style="{StaticResource BotaoMenuItem}"
                                                                    Tag="{Binding}"
                                                                    Click="EditarProduto_Click"/>

                                                            <Separator Margin="4"/>

                                                            <Button Content="Excluir"
                                                                    Style="{StaticResource BotaoMenuItem}"
                                                                    Foreground="#DC2626"
                                                                    Tag="{Binding}"
                                                                    Click="ExcluirProduto_Click"/>

                                                        </StackPanel>

                                                    </Border>

                                                </Popup>

                                            </Grid>

                                        </StackPanel>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>