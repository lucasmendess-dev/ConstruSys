<UserControl x:Class="ConstruSys.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Dashboard"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Visão geral do ConstruSys"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#6B7280"/>
            </StackPanel>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Vendas Hoje"
                                   Foreground="#6B7280"
                                   FontSize="14"/>

                        <TextBlock Text="R$ 0,00"
                                   Margin="0,10,0,0"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   Foreground="#111827"/>
                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Vendas no Mês"
                                   Foreground="#6B7280"
                                   FontSize="14"/>

                        <TextBlock Text="R$ 0,00"
                                   Margin="0,10,0,0"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   Foreground="#111827"/>
                    </StackPanel>

                </Border>

                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Produtos"
                                   Foreground="#6B7280"
                                   FontSize="14"/>

                        <TextBlock Text="0"
                                   Margin="0,10,0,0"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   Foreground="#111827"/>
                    </StackPanel>

                </Border>

                <Border Grid.Column="6"
                        Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Estoque Baixo"
                                   Foreground="#6B7280"
                                   FontSize="14"/>

                        <TextBlock Text="0"
                                   Margin="0,10,0,0"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   Foreground="#DC2626"/>
                    </StackPanel>

                </Border>

            </Grid>

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="25"
                        MinHeight="280">

                    <StackPanel>
                        <TextBlock Text="Resumo de Vendas"
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   Foreground="#1F2937"/>

                        <TextBlock Text="Os gráficos de vendas serão exibidos aqui."
                                   Margin="0,15,0,0"
                                   Foreground="#6B7280"/>
                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="25"
                        MinHeight="280">

                    <StackPanel>
                        <TextBlock Text="Alertas"
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   Foreground="#1F2937"/>

                        <TextBlock Text="Nenhum alerta no momento."
                                   Margin="0,15,0,0"
                                   Foreground="#6B7280"/>
                    </StackPanel>

                </Border>

            </Grid>

        </Grid>
    </ScrollViewer>

</UserControl>